{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "native-debug",
      "displayName": "Natif, debug + sanitizers (tests rapides)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "MONSTRES_SANITIZERS": "ON" }
    },
    {
      "name": "native-release",
      "displayName": "Natif, release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "web-debug",
      "displayName": "Web (lancer via emcmake), debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "web-release",
      "displayName": "Web (lancer via emcmake), release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "native-debug",   "configurePreset": "native-debug" },
    { "name": "native-release", "configurePreset": "native-release" },
    { "name": "web-debug",      "configurePreset": "web-debug" },
    { "name": "web-release",    "configurePreset": "web-release" }
  ],
  "testPresets": [
    { "name": "native-debug", "configurePreset": "native-debug", "output": { "outputOnFailure": true } },
    { "name": "web-debug",    "configurePreset": "web-debug",    "output": { "outputOnFailure": true } },
    { "name": "web-release",  "configurePreset": "web-release",  "output": { "outputOnFailure": true } }
  ]
}
